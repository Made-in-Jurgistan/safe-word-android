<?xml version="1.0" encoding="utf-8"?>
<!--
  Disables both cloud backups and device-to-device transfers because Safe Word
  stores potentially sensitive transcription history, personal dictionary entries,
  and custom voice commands locally. Users can re-onboard on new devices.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
